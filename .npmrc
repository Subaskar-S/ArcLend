# pnpm configuration for ArcLend monorepo

# Hoist all packages to node_modules/.pnpm for compatibility
# NestJS and Hardhat both rely on deep require resolution
shamefully-hoist=true

# Strict peer dep checking — warns but doesn't block installs
strict-peer-dependencies=false

# Don't auto-install peer deps (avoids version conflicts)
auto-install-peers=false

# Lockfile must be up to date in CI
# Uncomment in CI: frozen-lockfile=true
